# =============================================================================
# MakanReel — Video-First Property Listing Portal Environment Configuration
# =============================================================================
# Copy to .env.local for local overrides. Never commit .env.local or secrets.

# App runtime mode: "local" (zero-key local TUS + SSE + JSON store) or "supabase"
NEXT_PUBLIC_APP_MODE=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signed session cookie secret (generate 32+ random bytes in production)
SESSION_SECRET=replace-with-32-byte-random-secret-in-production

# -----------------------------------------------------------------------------
# Production Database, Auth & Realtime (Supabase)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Production Video Ingest, Adaptive HLS & CDN (Cloudflare Stream)
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
NEXT_PUBLIC_CLOUDFLARE_STREAM_SUBDOMAIN=

# -----------------------------------------------------------------------------
# Maps & Geocoding (MapLibre GL JS + OpenFreeMap default; optional MapTiler/Mapbox)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
NEXT_PUBLIC_MAPTILER_KEY=
MAPBOX_GEOCODING_TOKEN=

# -----------------------------------------------------------------------------
# Rate Limiting, Queueing & Observability (Optional in Local Mode)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
